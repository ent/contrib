{{/* gotype: entgo.io/ent/entc/gen.Type */}}

{{ define "import/additional/graphql-enum" }}
	"github.com/99designs/gqlgen/graphql"
{{ end }}

{{/* meta/additional/graphql-enum runs in the entity sub-package (e.g. category/category.go)
     where non-HasGoType enums are type aliases to internal types. Methods cannot be defined on
     aliases, so we only emit interface compliance checks for HasGoType enums here. The actual
     MarshalGQL/UnmarshalGQL methods for non-HasGoType enums are generated by
     model/additional/graphql-enum on the real types in the internal model package. */}}
{{ define "meta/additional/graphql-enum" }}

{{ range $f := $.EnumFields }}
	{{ $enum := trimPackage $f.Type.String $.Package -}}
	{{- if $f.HasGoType }}
		var (
			// {{ $enum }} must implement graphql.Marshaler.
			 _ graphql.Marshaler = (*{{ $enum }})(nil)
			// {{ $enum }} must implement graphql.Unmarshaler.
			 _ graphql.Unmarshaler = (*{{ $enum }})(nil)
		)
	{{- end }}
{{ end }}
{{ end }}

{{/* model/additional/graphql-enum generates MarshalGQL/UnmarshalGQL methods on the actual
     (non-alias) enum types defined in the internal model package. In the sub-package layout,
     the meta template defines type aliases (e.g. type Status = internal.CategoryStatus), so
     these methods must live on the real types in internal instead. */}}
{{ define "model/additional/graphql-enum" }}

{{ range $f := $.EnumFields }}
	{{ $enum := trimPackage $f.Type.String $.Package -}}
	{{ $useEnumNames := $f.Annotations.EntGQL.UseEnumNames -}}
	{{- if not $f.HasGoType }}
		{{ $internalEnum := printf "%s%s" $.Name $enum }}
		{{- if $useEnumNames }}
			var {{ $internalEnum }}GqlEnumToTypeMap = map[string]{{ $internalEnum }} {
			{{- range $e := $f.Enums }}
				"{{ trimPrefix $e.Name $f.StructField }}": {{ $internalEnum }}("{{ $e.Value }}"),
			{{- end }}
			}

			var {{ $internalEnum }}TypeToGqlEnum = map[{{ $internalEnum }}]string {
			{{- range $e := $f.Enums }}
				{{ $internalEnum }}("{{ $e.Value }}"): "{{ trimPrefix $e.Name $f.StructField }}",
			{{- end }}
			}
		{{- end }}
		// MarshalGQL implements graphql.Marshaler interface.
		func (e {{ $internalEnum }}) MarshalGQL(w io.Writer) {
			{{- if $useEnumNames }}
			io.WriteString(w, strconv.Quote({{ $internalEnum }}TypeToGqlEnum[e]))
			{{- else }}
			io.WriteString(w, strconv.Quote(e.String()))
			{{- end }}
		}

		// UnmarshalGQL implements graphql.Unmarshaler interface.
		func (e *{{ $internalEnum }}) UnmarshalGQL(val interface{}) error {
			str, ok := val.(string)
			if !ok {
				return fmt.Errorf("enum %T must be a string", val)
			}
			{{- if $useEnumNames }}
			{{ camel $internalEnum }}Val, ok := {{ $internalEnum }}GqlEnumToTypeMap[str]
			if !ok {
				return fmt.Errorf("%s is not a valid {{ $internalEnum }}", str)
			}
			*e = {{ camel $internalEnum }}Val
			return nil
			{{- else }}
			*e = {{ $internalEnum }}(str)
			switch str {
			case {{ range $i, $e := $f.Enums }}{{ if ne $i 0 }}, {{ end }}"{{ $e.Value }}"{{ end }}:
				return nil
			default:
				return fmt.Errorf("%s is not a valid {{ $internalEnum }}", str)
			}
			{{- end }}
		}
	{{- end }}
{{ end }}
{{ end }}
