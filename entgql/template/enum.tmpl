{{/* gotype: entgo.io/ent/entc/gen.Type */}}

{{ define "import/additional/graphql-enum" }}
	"github.com/99designs/gqlgen/graphql"
{{ end }}

{{/*
	model/additional/graphql-enum generates MarshalGQL/UnmarshalGQL methods on the
	concrete (entity-prefixed) enum types defined in the main package.
	Skipped when split-packages is enabled because the enum types live in subpackages;
	in that case, meta/additional/graphql-enum generates the methods instead.
*/}}
{{ define "model/additional/graphql-enum" }}
{{- if not ($.FeatureEnabled "split-packages") }}
{{ range $f := $.EnumFields }}
	{{ $enum := trimPackage $f.Type.String $.Package -}}
	{{ $internalEnum := printf "%s%s" $.Name $enum -}}
	{{ $fieldPrefix := pascal $f.Name -}}
	{{- if not $f.HasGoType }}
		// MarshalGQL implements graphql.Marshaler interface.
		func (e {{ $internalEnum }}) MarshalGQL(w io.Writer) {
			switch string(e) {
			{{- range $e := $f.Enums }}
			case "{{ $e.Value }}":
				io.WriteString(w, strconv.Quote("{{ trimPrefix $e.Name $fieldPrefix }}"))
			{{- end }}
			default:
				io.WriteString(w, strconv.Quote(string(e)))
			}
		}

		// UnmarshalGQL implements graphql.Unmarshaler interface.
		func (e *{{ $internalEnum }}) UnmarshalGQL(val interface{}) error {
			str, ok := val.(string)
			if !ok {
				return fmt.Errorf("enum %T must be a string", val)
			}
			switch str {
			{{- range $e := $f.Enums }}
			{{- $gqlName := trimPrefix $e.Name $fieldPrefix }}
			{{- if ne $gqlName $e.Value }}
			case "{{ $gqlName }}":
				*e = {{ $internalEnum }}("{{ $e.Value }}")
			{{- end }}
			{{- end }}
			case {{ range $i, $e := $f.Enums }}{{ if ne $i 0 }},{{ end }}"{{ $e.Value }}"{{ end }}:
				*e = {{ $internalEnum }}(str)
			default:
				return fmt.Errorf("%s is not a valid {{ $internalEnum }}", str)
			}
			return nil
		}
	{{- end }}
{{ end }}
{{- end }}
{{ end }}

{{/*
	meta/additional/graphql-enum handles:
	- GoType enum interface assertions (always).
	- Non-GoType enum MarshalGQL/UnmarshalGQL methods when split-packages is enabled,
	  since the enum types live in subpackages (e.g., agentlicensing.LicenseStatus)
	  and methods must be defined in the same package as the type.
*/}}
{{ define "meta/additional/graphql-enum" }}
{{ range $f := $.EnumFields }}
	{{ $enum := trimPackage $f.Type.String $.Package -}}
	{{- if $f.HasGoType }}
		var (
			// {{ $enum }} must implement graphql.Marshaler.
			 _ graphql.Marshaler = (*{{ $enum }})(nil)
			// {{ $enum }} must implement graphql.Unmarshaler.
			 _ graphql.Unmarshaler = (*{{ $enum }})(nil)
		)
	{{- end }}
	{{- if and (not $f.HasGoType) ($.FeatureEnabled "split-packages") }}
		{{ $fieldPrefix := pascal $f.Name -}}
		// MarshalGQL implements graphql.Marshaler interface.
		func (e {{ $enum }}) MarshalGQL(w io.Writer) {
			switch string(e) {
			{{- range $e := $f.Enums }}
			case "{{ $e.Value }}":
				io.WriteString(w, strconv.Quote("{{ trimPrefix $e.Name $fieldPrefix }}"))
			{{- end }}
			default:
				io.WriteString(w, strconv.Quote(string(e)))
			}
		}

		// UnmarshalGQL implements graphql.Unmarshaler interface.
		func (e *{{ $enum }}) UnmarshalGQL(val interface{}) error {
			str, ok := val.(string)
			if !ok {
				return fmt.Errorf("enum %T must be a string", val)
			}
			switch str {
			{{- range $e := $f.Enums }}
			{{- $gqlName := trimPrefix $e.Name $fieldPrefix }}
			{{- if ne $gqlName $e.Value }}
			case "{{ $gqlName }}":
				*e = {{ $enum }}("{{ $e.Value }}")
			{{- end }}
			{{- end }}
			case {{ range $i, $e := $f.Enums }}{{ if ne $i 0 }},{{ end }}"{{ $e.Value }}"{{ end }}:
				*e = {{ $enum }}(str)
			default:
				return fmt.Errorf("%s is not a valid {{ $enum }}", str)
			}
			return nil
		}
	{{- end }}
{{ end }}
{{ end }}
