{{ define "gql_node_descriptor_entity" }}

{{- /*gotype: entgo.io/contrib/entgql.nodeDescriptorEntityData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $node := $.Node }}
{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}
{{ $idType := gqlIDType $gqlNodes $.IDType }}

{{ $fields := filterFields $node.Fields (skipMode "type") }}
{{ $edges := filterEdges $node.Edges (skipMode "type") }}

import (
	"context"
	"encoding/json"

	{{- range $e := $edges }}
		"{{ $.Config.Package }}/{{ $e.Type.Package }}"
	{{- end }}
)

{{ $receiver := $node.Receiver }}
{{ $marshalID := and $idType.Mixed (gqlMarshaler $node.ID) }}
// Node implements Noder interface
func ({{ $receiver }} *{{ $node.Name }}) Node(ctx context.Context) (node *Node, err error) {
	node = &Node{
		ID: {{ $receiver }}.{{ if $marshalID }}marshalID(){{ else }}ID{{ end }},
		Type: "{{ $node.Name }}",
		Fields: make([]*Field, {{ len $fields }}),
		Edges: make([]*Edge, {{ len $edges }}),
	}
	{{- with $fields }}
		var buf []byte
		{{- range $i, $f := $fields }}
			if buf, err = json.Marshal({{ $receiver }}.{{ pascal $f.Name }}); err != nil {
				return nil, err
			}
			node.Fields[{{ $i }}] = &Field{
				Type:  "{{ $f.Type }}",
				Name:  "{{ $f.Name }}",
				Value: string(buf),
			}
		{{- end }}
	{{- end }}
	{{- with $edges }}
		{{- range $i, $e := $edges }}
			node.Edges[{{ $i }}] = &Edge{
				Type: "{{ $e.Type.Name }}",
				Name: "{{ $e.Name }}",
			}
			err = {{ $receiver }}.{{ print "Query" (pascal $e.Name) }}().
				Select({{ $e.Type.Package }}.FieldID).
				Scan(ctx, &node.Edges[{{ $i }}].IDs)
			if err != nil {
				return nil, err
			}
		{{- end }}
	{{- end }}
	return node, nil
}
{{ end }}
